# Környezeti változók sablonja. A valódi .env* fájlok nem kerülnek verziókezelésbe.
# - pnpm dev            → .env.development.local
# - pnpm start / build  → .env.production.local (vagy a szerver folyamat környezeti változói)
# - pnpm start:test     → a Next ezt is production módban futtatja, ezért a test szerveren a változókat
#                         a folyamat környezetében (pl. systemd / pm2 env) add meg, külön értékkel.

# Admin felhasználók (/admin): legfeljebb 5, "felhasználónév:jelszó" formában, a jelszó legalább 12 karakter.
# Belépéskor egy összeadós ellenőrző kérdést is meg kell oldani. Ha egy sincs megadva, az admin le van tiltva.
ADMIN_USER_1=
ADMIN_USER_2=
ADMIN_USER_3=
ADMIN_USER_4=
ADMIN_USER_5=

# A webshop nyilvános címe (a levelekben lévő linkekhez és a biztonságos sütikhez), pl. https://cupre.hu
# A Barion kártyás fizetéshez kötelező, és https-sel kell kezdődnie (visszairányítás és callback).
SITE_URL=

# Barion kártyás fizetés (company.json → shop.payments.card: { "enabled": true, "provider": "barion" })
# POSKey: a Barion fiókban a webshop (POS) titkos kulcsa; Payee: a Barion pénztárca e-mail címe
BARION_POS_KEY=
BARION_PAYEE=
# sandbox (api.test.barion.com) vagy production (api.barion.com)
BARION_ENVIRONMENT=sandbox
